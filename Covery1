<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Covery Shoes</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f4f4;
    }
    header {
      background: #111;
      color: white;
      padding: 20px;
      text-align: center;
    }
    .container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      padding: 20px;
    }
    .product {
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      margin: 15px;
      padding: 15px;
      width: 250px;
      text-align: center;
    }
    .product img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 5px;
    }
    .product h3 {
      margin: 10px 0 5px;
    }
    .product p {
      font-size: 18px;
      color: #333;
    }
    footer {
      background: #111;
      color: white;
      text-align: center;
      padding: 15px;
    }
    .social-links a {
      color: white;
      margin: 0 10px;
      text-decoration: none;
      font-size: 20px;
    }
    .social-links a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <header>
    <h1>Covery Shoes</h1>
    <p>Stylish. Comfortable. Affordable.</p>
  </header>

  <div class="container">
    <!-- Example Shoe -->
    <div class="product">
      <img src="shoe1.jpg" alt="Nike Air Max">
      <h3>Nike Air Max</h3>
      <p>€89.99</p>
    </div>

    <div class="product">
      <img src="shoe2.jpg" alt="Adidas Ultraboost">
      <h3>Adidas Ultraboost</h3>
      <p>€119.99</p>
    </div>

    <div class="product">
      <img src="shoe3.jpg" alt="Puma RS-X">
      <h3>Puma RS-X</h3>
      <p>€99.99</p>
    </div>

    <!-- Add more shoes here -->
  </div>

  <footer>
    <p>&copy; 2025 Covery Shoes. All rights reserved.</p>
    <div class="social-links">
      <a href="https://facebook.com/coveryshoes" target="_blank">Facebook</a>
      <a href="https://instagram.com/coveryshoes" target="_blank">Instagram</a>
    </div>
  </footer>
</body>
</html>
